pipeline {
    agent any
    tools {
        jdk 'jdk21'
        nodejs 'node26'
    }
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }
    stages {
        stage ("Clean Workspace") {
            steps {
                cleanWs()
            }
        }
        stage ("Pull Code from Github") {
            steps {
                git 'https://github.com/HardikYadav99/Zomato-Deployment.git'
            }
        }
        stage ("SonarQube Analysis") {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh ''' $SCANNER_HOME/bin/sonar-scanner -Dsonar.projectName=zomato \
                    -Dsonar.projectKey=zomato '''
                }
            }
        }
        stage ("Quality Gate Check") {
            steps {
                script {
                    waitForQualityGate abortpipeline: false, credentialsId: 'Sonar-token'
                }
            }
        }
        stage("Install NPM Dependencies") {
            steps {
                sh "npm install"
            }
        }
        stage ("OWASP FS SCAN") {
            steps {
                // FIXED: Corrected spelling of 'additionalArguments'
                dependencyCheck additionalArguments: '--scan ./ --disableYarnAudit -n', odcInstallation: 'DP-Check'
                dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
            }
        }
        stage("Trivy Scan") {
            steps {
                sh "trivy fs --exit-code 1 --severity HIGH,CRITICAL . > trivy.txt"
            }
        }
        stage ("Build Docker Image") {
            steps {
                sh "docker build -t zomato ."
            }
        }
        stage ("Push to DockerHub") {
            steps {
                script {
                    withDockerRegistry(credentialsId: "docker") {
                        sh "docker tag zomato hardiky99/zomato:latest"
                        sh "docker push hardiky99/zomato:latest"
                    }
                }
            }
        }
        stage ("Docker Scout Image") {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {
                        sh 'docker-scout quickview hardiky99/zomato:latest'
                        sh 'docker-scout cves hardiky99/zomato:latest'
                        sh 'docker-scout recommendations hardiky99/zomato:latest'
                    }
                }
            }
        }
        stage ("Deploy to container") {
            steps {
                // FIXED: Remove existing container to avoid "Name already in use" error
                sh 'docker rm -f zomato || true' 
                sh 'docker run -d --name zomato -p 3000:3000 hardiky99/zomato:latest'
            }
        }
    }
    post {
        always {
            // Archive trivy.txt so it is available for email attachments
            archiveArtifacts artifacts: 'trivy.txt', fingerprint: true
            
            emailext attachLog: true,
                subject: "Build ${currentBuild.result ?: 'SUCCESS'}: ${env.JOB_NAME}",
                body: """
                <html>
                <body>
                    <div style="background-color: #FFA07A; padding: 10px; margin-bottom: 10px;">
                        <p style="color: white; font-weight: bold;">Project: ${env.JOB_NAME}</p>
                    </div>
                    <div style="background-color: #90EE90; padding: 10px; margin-bottom: 10px;">
                        <p style="color: white; font-weight: bold;">Build Number: ${env.BUILD_NUMBER}</p>
                    </div>
                </body>
                </html>
                """,
                to: 'rs70988@gmail.com',
                mimeType: 'text/html',
                attachmentsPattern: 'trivy.txt'
        }
    }
}